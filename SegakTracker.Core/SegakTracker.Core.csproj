<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-independent logic for SEGAK Tracker: models, SEGAK scoring,
    persistence and view models. Kept free of MAUI dependencies so it can be
    unit tested on any machine with the plain .NET SDK.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SegakTracker.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SegakTracker.Tests" />
  </ItemGroup>

</Project>
