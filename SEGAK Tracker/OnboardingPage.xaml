<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SEGAK_Tracker.OnboardingPage"
             BackgroundColor="#001311">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand">
            <Image Source="onboarding_image.png" Aspect="AspectFill" HorizontalOptions="FillAndExpand" HeightRequest="300" WidthRequest="300" Margin="0,45,0,0"/>
            <Frame Background="{StaticResource RedGradientBackground}" BorderColor="Black" CornerRadius="20" HeightRequest="462" Padding="15" Margin="0,25,0,0">
                <!-- Rounded corners on top only -->
                <VerticalStackLayout Padding="20">
                    <Label Text="Elevate Your SEGAK Prep"
                           FontSize="26"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           Margin="0,15,0,0"
                           TextColor="White"
                           Style="{StaticResource LabelShadowStyle}"/>
                    <Label Text="Tailoring your SEGAK training has never been simpler. Get ready to meet your fitness goals and ace your school's physical assessment!"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="White"
                           Style="{StaticResource LabelShadowStyle2}"
                           Margin="0,30,0,30"/>
                    <!-- Adjusted bottom margin for better spacing -->
                    <Button Text="Begin Your Journey"
                            Background="{StaticResource ButtonGradientBackground}"
                            BorderColor="Black"
                            BorderWidth="2"
                            FontSize="16"
                            FontAttributes="Bold"
                            WidthRequest="200"
                            HeightRequest="50"
                            CornerRadius="10"
                            HorizontalOptions="Center"
                            Margin="0,5,0,30"
                            Command="{Binding StartCommand}"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
