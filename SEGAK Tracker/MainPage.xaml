<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="SEGAK_Tracker.MainPage"
            Title="Main Menu">

    <!-- Flyout menu part -->
    <FlyoutPage.Flyout>
        <ContentPage Title="Menu">
            <ScrollView>
                <VerticalStackLayout Spacing="20" Padding="20">
                    <Button Text="Fitness Tracking" Clicked="OnMenuButtonClicked" />
                    <Button Text="Training Program" Clicked="OnMenuButtonClicked" />
                    <Button Text="Progress List" Clicked="OnMenuButtonClicked" />
                </VerticalStackLayout>
            </ScrollView>
        </ContentPage>
    </FlyoutPage.Flyout>

    <!-- Detail content part -->
    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <ContentPage BackgroundColor="#1E1232" Title="Start your training today!">
                    <ScrollView>
                        <VerticalStackLayout Spacing="10" Padding="15,35">
                            <!-- Header with Icon -->
                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                                <Image Source="fitness_icon.png" WidthRequest="120" HeightRequest="120" VerticalOptions="Center" />
                                <Label Text="Ready to Improve Your Fitness?"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="Center"
                                       HorizontalOptions="StartAndExpand"
                                       Margin="10,0,10,0" />
                            </StackLayout>

                            <!-- Daily Training Task Frame -->
                            <Frame BackgroundColor="#FF0266" CornerRadius="20" Padding="15" Margin="0,5,0,5" HasShadow="True">
                                <StackLayout Orientation="Vertical" Spacing="10">
                                    <Label Text="Daily training task - muscle strength &amp; endurance"
                                           FontSize="18"
                                           TextColor="White"
                                           FontAttributes="Bold"/>
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <Image Source="clock_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                                        <Label Text="5 of 6 completed"
                                               FontSize="16"
                                               TextColor="White"
                                               VerticalOptions="Center"/>
                                    </StackLayout>
                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                        <Image Source="clock_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                                        <Label Text="20 more minutes - squat"
                                               FontSize="16"
                                               TextColor="White"
                                               VerticalOptions="Center"/>
                                    </StackLayout>
                                    <Image Source="arrow_right.png" HorizontalOptions="End" VerticalOptions="Center" WidthRequest="30" HeightRequest="30"/>
                                </StackLayout>
                            </Frame>

                            <!-- Training Program and See All -->
                            <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" Padding="10,0">
                                <Label Text="Training Program"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       VerticalOptions="Center"
                                       HorizontalOptions="StartAndExpand"/>
                                <Label Text="See all"
                                       FontSize="16"
                                       TextColor="#BB86FC"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"/>
                            </StackLayout>

                            <!-- Body Composition Frame -->
                            <Frame BackgroundColor="#FFA500" CornerRadius="20" Padding="0" Margin="0,5,0,5" HasShadow="True">
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                    <Label Text="Body Composition - 6 tasks"
                                           FontSize="16"
                                           TextColor="White"
                                           VerticalOptions="Center"
                                           HorizontalOptions="StartAndExpand"
                                           Margin="30,0,10,0"/>
                                    <Image Source="composition_icon.png" WidthRequest="97" HeightRequest="97" VerticalOptions="Center" HorizontalOptions="End"/>
                                </StackLayout>
                            </Frame>

                            <!-- Flexibility Frame -->
                            <Frame BackgroundColor="#00AB66" CornerRadius="20" Padding="0" Margin="0,5,0,5" HasShadow="True">
                                <StackLayout Orientation="Horizontal" HorizontalOptions="FillAndExpand" VerticalOptions="Center">
                                    <Label Text="Flexibility - 4 tasks"
                                           FontSize="16"
                                           TextColor="White"
                                           VerticalOptions="Center"
                                           HorizontalOptions="StartAndExpand"
                                           Margin="30,0,10,0"/>
                                    <Image Source="flexibility_icon.png" WidthRequest="105" HeightRequest="105" VerticalOptions="Center" HorizontalOptions="End"/>
                                </StackLayout>
                            </Frame>
                        </VerticalStackLayout>
                    </ScrollView>
                </ContentPage>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>