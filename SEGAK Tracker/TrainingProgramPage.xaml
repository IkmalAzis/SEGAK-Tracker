<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SegakTracker.Core.ViewModels;assembly=SegakTracker.Core"
             x:Class="SEGAK_Tracker.TrainingProgramPage"
             x:DataType="vm:TrainingProgramViewModel"
             Title="SEGAK Training Program">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="16,20">
            <Label Text="Time to train!"
                   Style="{StaticResource ScreenTitle}"
                   HorizontalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Pick a SEGAK test and tick off today's tasks. Your ticks reset every day."
                   Style="{StaticResource MutedLabel}"
                   HorizontalTextAlignment="Center" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Exercises}" Spacing="15">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExerciseCardViewModel">
                        <Border Style="{StaticResource Card}"
                                Padding="10"
                                BackgroundColor="{Binding AccentColor, Converter={StaticResource HexToColor}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrainingProgramViewModel}}, Path=OpenExerciseCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Image Source="{Binding ImageName}" WidthRequest="100" HeightRequest="100" Aspect="AspectFill" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="{Binding Focus}" FontSize="13" TextColor="White" Opacity="0.9" />
                                    <ProgressBar Progress="{Binding Progress}" ProgressColor="White" Margin="0,4,0,0" />
                                    <Label Text="{Binding ProgressText}" FontSize="13" TextColor="White" />
                                </VerticalStackLayout>
                                <Image Grid.Column="2" Source="arrow_right.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
