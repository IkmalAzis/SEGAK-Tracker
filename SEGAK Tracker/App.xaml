<?xml version="1.0" encoding="UTF-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:SEGAK_Tracker.Converters"
             x:Class="SEGAK_Tracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:HasTextConverter x:Key="HasText" />
            <converters:HexToColorConverter x:Key="HexToColor" />

            <Style x:Key="LabelShadowStyle" TargetType="Label">
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Radius="15" Opacity="1" Brush="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LabelShadowStyle2" TargetType="Label">
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Radius="5" Opacity="1" Brush="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <LinearGradientBrush x:Key="RedGradientBackground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#A20025" Offset="0.1"/>
                <GradientStop Color="#000000" Offset="1.0"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ButtonGradientBackground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#76608A" Offset="0.0"/>
                <GradientStop Color="#000000" Offset="1.0"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="SilverButtonBackground" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#BDBDBD" Offset="0.0"/>
                <GradientStop Color="#1A1A1A" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- Shared building blocks for the redesigned screens -->
            <Style x:Key="ScreenTitle" TargetType="Label">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource White}" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Radius="6" Opacity="0.8" Brush="Black"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource White}" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource White}" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
            <Style x:Key="MutedLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource MutedText}" />
            </Style>
            <Style x:Key="ErrorLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource ErrorText}" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Radius="8" Opacity="0.5" Brush="Black" Offset="0,3"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Highlight}" />
                <Setter Property="Stroke" Value="{StaticResource Black}" />
                <Setter Property="StrokeThickness" Value="2" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="14,6" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SilverButtonBackground}" />
                <Setter Property="TextColor" Value="{StaticResource White}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="54" />
                <Setter Property="BorderColor" Value="{StaticResource Black}" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource MutedText}" />
                <Setter Property="BorderColor" Value="{StaticResource MutedText}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
